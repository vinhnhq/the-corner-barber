{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "react-perf", "typescript", "unicorn", "oxc", "nextjs", "jsx-a11y"],
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error", "info"]
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "unicorn/prefer-node-protocol": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/label-has-associated-control": [
      "error",
      {
        "controlComponents": ["Input", "Textarea", "NativeSelect", "Select"],
        "depth": 3
      }
    ]
  },
  "ignorePatterns": ["src/components/ui/**", ".next/**", "node_modules/**", "_source-assets/**"]
}
