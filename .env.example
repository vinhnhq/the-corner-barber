# Local SQLite. Swap for a Turso URL + auth token when this goes to Vercel:
#   DATABASE_URL="libsql://<db>-<org>.turso.io"
#   DATABASE_AUTH_TOKEN="..."
DATABASE_URL="file:./data/corner.db"
DATABASE_AUTH_TOKEN=""

# /admin has NO authentication. It is enabled in development and must stay
# disabled in production until real auth exists.
ADMIN_ENABLED="true"

# Staff notification on a new booking request. Unset => logged to the console.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Google Calendar — confirmed bookings become events on the shop's calendar.
# Auth is a SERVICE ACCOUNT, not OAuth: create one, then share the shop's
# calendar with the address below and grant "Make changes to events".
# Unset => the integration logs what it would have done and does nothing.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# The full PEM from the service account's JSON key, on one line with \n escapes.
GOOGLE_PRIVATE_KEY=""
# The shop calendar's id — Calendar settings → "Integrate calendar" → Calendar ID.
GOOGLE_CALENDAR_ID=""
