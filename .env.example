# Local SQLite. Swap for a Turso URL + auth token when this goes to Vercel:
#   DATABASE_URL="libsql://<db>-<org>.turso.io"
#   DATABASE_AUTH_TOKEN="..."
DATABASE_URL="file:./data/corner.db"
DATABASE_AUTH_TOKEN=""

# /admin — staff screens.
#
# Locally the admin is on by default and needs nothing here.
#
# On a deployed site it requires BOTH of the next two: the opt-in AND a
# password. Either one alone leaves the section returning 404, so setting
# ADMIN_ENABLED by itself can never publish customer names and phone numbers.
#
# ADMIN_PASSWORD turns on HTTP Basic auth for /admin (see src/proxy.ts). It is
# a shared password, not a login — fine for one operator over HTTPS, and worth
# replacing with real accounts before more people need access.
ADMIN_ENABLED=""
ADMIN_PASSWORD=""
# Optional; defaults to "admin".
ADMIN_USER=""

# Staff notification on a new booking request. Unset => logged to the console.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Google Calendar — confirmed bookings become events on the shop's calendar.
# Auth is a SERVICE ACCOUNT, not OAuth: create one, then share the shop's
# calendar with the address below and grant "Make changes to events".
# Unset => the integration logs what it would have done and does nothing.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# The full PEM from the service account's JSON key, on one line with \n escapes.
GOOGLE_PRIVATE_KEY=""
# The shop calendar's id — Calendar settings → "Integrate calendar" → Calendar ID.
GOOGLE_CALENDAR_ID=""
